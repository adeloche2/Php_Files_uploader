# Copy values into Vercel Project Settings > Environment Variables.
# Never commit actual secrets.
DB_HOST=your-managed-mysql-host
DB_PORT=3306
DB_DATABASE=image_uploader
DB_USERNAME=image_uploader_user
DB_PASSWORD=replace-with-a-strong-password
DB_CHARSET=utf8mb4

# S3-compatible object storage (Cloudflare R2, AWS S3, etc.)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-private-image-bucket
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key

# Generate a random secret of at least 32 characters.
APP_KEY=replace-with-a-long-random-secret-at-least-32-characters
APP_TIMEZONE=Africa/Algiers

# Keep false on public deployments. Enabling this without admin authentication is unsafe.
ENABLE_PUBLIC_DELETE=false
