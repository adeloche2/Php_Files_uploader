{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/upload-url/?$", "dest": "/api/upload-url.php" },
    { "src": "/api/upload-complete/?$", "dest": "/api/upload-complete.php" },
    { "src": "/image\\.php$", "dest": "/api/image.php" },
    { "src": "/download\\.php$", "dest": "/api/download.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}